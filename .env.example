# ====== Master VPN bot — пример конфигурации. Скопируйте в .env и заполните. ======

# --- Telegram ---
BOT_TOKEN=123456:ABC
# Telegram ID администраторов через запятую (получают алерты и могут /user /stats /pending)
ADMIN_IDS=111111111

# --- Partner API «Мастерская VPN» ---
PARTNER_API_BASE=https://api.subkeyapi.com
PARTNER_API_KEY=uk_...
# Секрет вебхука: python -m app.scripts.set_webhook (печатает новый секрет при каждом запуске)
PARTNER_WEBHOOK_SECRET=

# --- Домен и БД ---
# Домен с A-записью на ваш VPS: на него придут вебхуки Partner API и CryptoPay
DOMAIN=bot.example.com
PUBLIC_BASE_URL=https://bot.example.com
POSTGRES_PASSWORD=change-me
# При запуске через docker compose DATABASE_URL собирается автоматически; для локального запуска:
DATABASE_URL=postgresql+asyncpg://master:change-me@localhost:5432/master

# --- Бренд и ссылки (CHANGE_ME = не заполнено, бот предупредит админа при старте) ---
BRAND_NAME=Master VPN
BRAND_ANNOUNCE=Поддержка в Telegram
SUPPORT_URL=https://t.me/CHANGE_ME
WEB_URL=https://example.com/CHANGE_ME
LINK_ANDROID=https://example.com/CHANGE_ME
LINK_IOS=https://example.com/CHANGE_ME
LINK_WINDOWS=https://example.com/CHANGE_ME
LINK_POLICY=https://example.com/CHANGE_ME
LINK_TERMS=https://example.com/CHANGE_ME

# --- Оплата ---
# USDT через CryptoPay (@CryptoBot -> Crypto Pay -> Create App). Webhook: https://<домен>/cryptopay-webhook
CRYPTOPAY_TOKEN=
CRYPTOPAY_API_BASE=https://pay.crypt.bot/api
# Рубли (СБП) через platega.io: пока заглушка «скоро будет доступно»
PLATEGA_ENABLED=false

# --- Прочее ---
WEBHOOK_PORT=8080
THROTTLE_SECONDS=1.0
REMINDER_DAYS=3
REMINDER_HOURS_UTC=6-17
LOG_LEVEL=INFO

# --- Цены: PRICE_<RUB|STARS|USDT>_<срок в месяцах>M_<устройств>D ---
# ЗНАЧЕНИЯ НИЖЕ – ПРИМЕРЫ. Рубли и Stars – целые числа, USDT – до двух знаков после точки.
# Себестоимость в Partner API: 75 / 105 / 150 / 300 ₽ за 30 суток на 1 / 2 / 4 / 8 устройств.

# RUB
PRICE_RUB_1M_1D=150
PRICE_RUB_3M_1D=450
PRICE_RUB_6M_1D=850
PRICE_RUB_1M_2D=210
PRICE_RUB_3M_2D=630
PRICE_RUB_6M_2D=1190
PRICE_RUB_1M_4D=300
PRICE_RUB_3M_4D=900
PRICE_RUB_6M_4D=1700
PRICE_RUB_1M_8D=600
PRICE_RUB_3M_8D=1800
PRICE_RUB_6M_8D=3400

# STARS
PRICE_STARS_1M_1D=110
PRICE_STARS_3M_1D=330
PRICE_STARS_6M_1D=620
PRICE_STARS_1M_2D=155
PRICE_STARS_3M_2D=460
PRICE_STARS_6M_2D=870
PRICE_STARS_1M_4D=220
PRICE_STARS_3M_4D=660
PRICE_STARS_6M_4D=1250
PRICE_STARS_1M_8D=440
PRICE_STARS_3M_8D=1320
PRICE_STARS_6M_8D=2500

# USDT
PRICE_USDT_1M_1D=1.70
PRICE_USDT_3M_1D=5.00
PRICE_USDT_6M_1D=9.50
PRICE_USDT_1M_2D=2.40
PRICE_USDT_3M_2D=7.10
PRICE_USDT_6M_2D=13.50
PRICE_USDT_1M_4D=3.40
PRICE_USDT_3M_4D=10.10
PRICE_USDT_6M_4D=19.10
PRICE_USDT_1M_8D=6.80
PRICE_USDT_3M_8D=20.20
PRICE_USDT_6M_8D=38.20
